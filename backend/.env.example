# ReLoop backend — local development environment.
#
# Copy this file to `backend/.env` (git-ignored) and fill in the values you need.
# Spring Boot imports that file automatically, so this works with no shell exports:
#
#   cd backend
#   cp .env.example .env
#   ./mvnw spring-boot:run
#
# Real environment variables still take precedence, which is how deployments
# (application-prod.yml) are configured. Never commit a real secret: `backend/.env`
# is ignored by .gitignore and only this example file is tracked.

# ---------------------------------------------------------------------- required
# HS256 signing key for access tokens — at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------- optional
# Database. Defaults to jdbc:postgresql://localhost:5432/reloop_dev using your OS
# user, which works with local trust/peer auth. Uncomment to point elsewhere.
# DB_URL=jdbc:postgresql://localhost:5432/reloop_dev
# DB_USERNAME=
# DB_PASSWORD=

# AI waste scanning (Google Gemini Vision). The ONLY variable required to switch the
# scanner on is GEMINI_API_KEY. Without it, POST /api/waste/analyze answers 503 with
# "AI analysis is not configured on this server" — the client then falls back to manual
# classification, and no result is ever fabricated. Put the key here (never in source,
# never in git):
#
#   1. Create a key at https://aistudio.google.com/apikey
#   2. Paste it below, uncommented
#   3. Restart the backend — the startup log then reads:
#        "Gemini waste analysis enabled with model gemini-3.6-flash"
#
# The key stays server-side; it is only ever sent to Google from the backend and is
# never exposed to the browser or returned by any API response.
# GEMINI_API_KEY=

# Optional model override. Must be a model the Gemini API still serves:
# https://ai.google.dev/gemini-api/docs/deprecations (gemini-2.0-flash was shut down
# on 2026-06-01, so do not point this at it).
# GEMINI_MODEL=gemini-3.6-flash

# First-run administrator bootstrap. Only used when no admin exists yet; the password
# is hashed on creation and is never stored or logged in plain text.
# ADMIN_EMAIL=admin@reloop.local
# ADMIN_PASSWORD=

# Development mode returns the password-reset token in the API response, because this
# build has no mail transport configured. Leave false/absent outside local development.
# RELOOP_DEV_MODE=true

# Calendar zone used for the bare dates a person supplies — the recycling history "from"/"to"
# filters and the collector's "today" figure. Instants are always stored in UTC; only the
# interpretation of a calendar day depends on this, so it is deliberately NOT the host zone:
# running UTC would drop everything a household collected between local midnight and 05:30
# from a "from today" filter. Defaults to the seeded network's region.
# RELOOP_TIMEZONE=Asia/Kolkata

# Browser origins allowed to call the API (comma separated).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploaded scan/pickup images.
# STORAGE_LOCAL_DIR=./data/uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads
