# ReLoop backend — local development environment.
#
# Copy this file to `backend/.env` (git-ignored) and fill in the values you need.
# Spring Boot imports that file automatically, so this works with no shell exports:
#
#   cd backend
#   cp .env.example .env
#   ./mvnw spring-boot:run
#
# Real environment variables still take precedence, which is how deployments
# (application-prod.yml) are configured. Never commit a real secret: `backend/.env`
# is ignored by .gitignore and only this example file is tracked.

# ---------------------------------------------------------------------- required
# HS256 signing key for access tokens — at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------- optional
# Database. Defaults to jdbc:postgresql://localhost:5432/reloop_dev using your OS
# user, which works with local trust/peer auth. Uncomment to point elsewhere.
# DB_URL=jdbc:postgresql://localhost:5432/reloop_dev
# DB_USERNAME=
# DB_PASSWORD=

# AI classification (Google Gemini). Without a key, POST /api/waste/analyze answers
# 503 and the client falls back to manual classification — it never fabricates a result.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# First-run administrator bootstrap. Only used when no admin exists yet; the password
# is hashed on creation and is never stored or logged in plain text.
# ADMIN_EMAIL=admin@reloop.local
# ADMIN_PASSWORD=

# Development mode returns the password-reset token in the API response, because this
# build has no mail transport configured. Leave false/absent outside local development.
# RELOOP_DEV_MODE=true

# Browser origins allowed to call the API (comma separated).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploaded scan/pickup images.
# STORAGE_LOCAL_DIR=./data/uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads
